{
  "expo": {
    "name": "Hidayah",
    "slug": "hidayah",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hidayah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hidayah.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bandhanhara.hidayah",
      "adaptiveIcon": {
        "backgroundColor": "#15805a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15805a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hidayah uses your location to show accurate prayer times, the Hijri calendar, and the Qibla direction for where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#15805a",
          "sounds": [
            "./assets/sounds/adhan_makkah.wav",
            "./assets/sounds/adhan_fajr.wav"
          ]
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.hidayah.app",
          "widgets": [
            {
              "name": "NextPrayer",
              "displayName": "Next Prayer",
              "description": "The next prayer, its time and a live countdown.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextPrayer",
              "label": "Next Prayer",
              "description": "The next prayer and time left",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b275f8f4-310e-4653-9014-f3cd0c55930a"
      }
    },
    "owner": "sharifruet"
  }
}
